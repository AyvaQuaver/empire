# Empire environment — copy to .env and adjust. Dummy values only; never commit real secrets.

# Explicit deployment environment for the API server:
#   development (local machine, dev defaults) | test (automated suites)
#   staging (deployed: secrets + SMTP REQUIRED) | production (as staging)
# Falls back to NODE_ENV when unset.
EMPIRE_ENV=development

# SQLite database file (relational source of truth). Deployments MUST point this
# at a persistent volume, not an ephemeral container filesystem.
EMPIRE_DB_FILE=./data/empire.db

# Port for the Express API server (serves both the built frontend and the API).
PORT=8787

# Public base URL of the deployed app. Used in emails and links.
# Local default: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Stable scrypt pepper. Must stay IDENTICAL across restarts/redeploys.
# For staging/production generate a fresh unique value: `openssl rand -base64 32`.
# WARNING: changing it later makes existing password hashes unverifiable — every
# user would need a password reset. Never commit the real value.
SESSION_SECRET=dev-only-change-me

# --- Email (REQUIRED for staging/production; validated at startup) ---
# Without SMTP_HOST in local development, verification/reset emails are stored
# in the local email_outbox table (dev fixture). Staging/production fail startup
# without complete SMTP settings and never write emails to a dev outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Empire <no-reply@localhost>"

# Development-only email preview CLI (npm run email:outbox). Enable ONLY in local
# dev (EMPIRE_ENV=development). Staging/production reject this flag at startup.
ALLOW_DEV_EMAIL_PREVIEW=

# Explicit guest-only preview: false disables ALL account features server-side
# (register/sign-in/reset/friends/invites) with a clear player-facing notice.
# Guest play continues; existing accounts are kept (never deleted). Unset = true.
# When AUTH_ACCOUNTS_ENABLED=false, staging/production may omit SMTP.
AUTH_ACCOUNTS_ENABLED=true

# Comma-separated allowed CORS origins for the API (frontend origins).
CORS_ORIGINS=http://localhost:5173

# Scheduled cleanup: inactive/abandoned rounds are purged after this many hours of inactivity.
PURGE_INACTIVITY_HOURS=24
