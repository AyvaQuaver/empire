# Empire environment — copy to .env and adjust. Dummy values only; never commit real secrets.

# Node environment for the API server: development | staging | production
NODE_ENV=development

# SQLite database file (relational source of truth)
EMPIRE_DB_FILE=./data/empire.db

# Port for the Express API server
PORT=8787

# Public base URL of the frontend deployment. Used in emails and links.
# Local default: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Secret used to derive session token hashes. Provide a long random value in staging (e.g. `openssl rand -hex 32`).
SESSION_SECRET=dev-only-change-me

# --- Email (optional in local development) ---
# When SMTP_HOST is empty, verification/reset emails are stored in the `email_outbox`
# table and printed to the server console. That is NOT suitable for staging: configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Empire <no-reply@localhost>"

# Development-only email preview endpoint. Enable ONLY in local dev, never in staging/production.
ALLOW_DEV_EMAIL_PREVIEW=true

# Comma-separated allowed CORS origins for the API (frontend origins).
CORS_ORIGINS=http://localhost:5173

# Scheduled cleanup: inactive/abandoned rounds are purged after this many hours of inactivity.
PURGE_INACTIVITY_HOURS=24
