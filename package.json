{
  "name": "empire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && vite build",
    "typecheck": "npm run build --ignore-scripts",
    "server": "tsx server/src/index.ts",
    "test": "vitest run",
    "cleanup": "tsx scripts/cleanup.ts",
    "db:reset": "node -e \"require('fs').rmSync(process.env.EMPIRE_DB_FILE || './data/empire.db',{force:true}); require('fs').rmSync(process.env.EMPIRE_DB_FILE || './data/empire.db-journal',{force:true})\" && rm -rf data && mkdir -p data"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/nunito-sans": "^5.1.0",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
